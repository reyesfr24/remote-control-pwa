{
  "name": "remote-control-pwa",
  "version": "0.1.0",
  "private": true,
  "description": "Mando a distancia para Windows desde iPad/iPhone (PWA + servidor local)",
  "type": "module",
  "scripts": {
    "dev": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "icons": "node scripts/make-icons.js",
    "autostart:install": "node scripts/autostart.js install",
    "autostart:remove": "node scripts/autostart.js remove"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "express": "^5.3.0",
    "multicast-dns": "^7.2.5",
    "node-forge": "^1.4.2",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}
